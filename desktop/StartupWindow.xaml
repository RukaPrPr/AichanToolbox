<Window x:Class="AichanToolbox.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="艾酱图片工具箱"
        Icon="Assets/aichan-windows.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="#EEF1F4">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="StartupSurface">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Color="#FFFDFEFF" Offset="0" />
                <GradientStop Color="#FFF4F3FA" Offset="0.48" />
                <GradientStop Color="#FFEEF1F4" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Border x:Name="StartupLogo" Width="94" Height="94" CornerRadius="47" BorderThickness="0"
                Background="Transparent" Opacity="0.72" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#6A6673" BlurRadius="22" ShadowDepth="0" Opacity="0.2" />
            </Border.Effect>
            <Image Width="92" Height="92" Source="Assets/aichan-startup.png" Stretch="Uniform"
                   SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.68" To="1" Duration="0:0:0.52" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>
    </Grid>
</Window>
