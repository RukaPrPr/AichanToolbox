<Window x:Class="AichanToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="艾酱图片工具箱"
        Icon="Assets/aichan-windows.ico"
        Width="1520" Height="940"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#EEF1F4">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="10" CornerRadius="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="BrowserHost" Background="#EEF1F4" ClipToBounds="True">
        <wv2:WebView2 x:Name="Browser" Margin="0" DefaultBackgroundColor="#EEF1F4" />
    </Grid>
</Window>
